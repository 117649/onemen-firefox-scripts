{
  "name": "firefox_scripts",
  "version": "1.0.0",
  "description": "Scripts for installing legacy extension on Firefox",
  "scripts": {
    "lint": "eslint --config ./config/eslint.config.js --cache --cache-strategy content --cache-location ./config/.eslintcache",
    "format": "prettier --config ./config/prettier.config.js --ignore-path ./config/.prettierignore . --check",
    "format:fix": "prettier --config ./config/prettier.config.js --ignore-path ./config/.prettierignore . --write"
  },
  "keywords": [],
  "author": "ONEMEN <tabmix.onemen@gmail.com> (https://github.com/onemen)",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.6",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mozilla": "4.4.0",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "prettier-plugin-jsdoc": "1.8.0"
  }
}
